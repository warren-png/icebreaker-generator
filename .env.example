# Exemple de configuration - Copiez ce fichier en .env et remplissez vos vraies clés

ANTHROPIC_API_KEY=votre_cle_anthropic_ici
APIFY_API_TOKEN=votre_token_apify_ici
SERPER_API_KEY=votre_cle_serper_ici

# Coach Prospection — transcription d'appels (AssemblyAI)
# Inscription gratuite avec ~50h de crédit : https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=votre_cle_assemblyai_ici

# Leonar CRM
LEONAR_EMAIL=votre_email_leonar@exemple.com
LEONAR_PASSWORD=votre_mot_de_passe_leonar
LEONAR_CAMPAIGN_ID=votre_id_campagne_leonar

# Google Drive / Sheets
# Chemin ABSOLU vers le fichier de credentials Google Service Account
# NE PAS mettre de valeur par défaut ici — le fichier ne doit jamais être à la racine du projet
GOOGLE_CREDENTIALS_FILE=/chemin/absolu/vers/google-credentials.json
# ID du dossier Google Drive où uploader les CVs
GOOGLE_DRIVE_FOLDER_ID=votre_id_dossier_google_drive
GOOGLE_SHEET_NAME=Prospects Icebreaker
WORKSHEET_NAME=Feuille 1

# Authentification de l'application Streamlit
# Choisissez un mot de passe fort (min. 16 caractères)
APP_PASSWORD=choisir_un_mot_de_passe_fort_ici